{
  "name": "book-lending-system",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "TZ=Asia/Tokyo next dev",
    "build": "TZ=Asia/Tokyo next build",
    "start": "TZ=Asia/Tokyo next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:db:up": "docker compose up -d --wait test-db",
    "test:db:down": "docker compose down",
    "test:integration": "TEST_DATABASE_URL=postgresql://postgres:book_test@127.0.0.1:55432/book_lending_test RUN_DB_TESTS=1 TZ=UTC vitest run tests/integration tests/api/admin/genre-points.integration.test.ts tests/api/admin/events-dashboard.route.test.ts",
    "e2e:db:up": "docker compose up -d --wait e2e-db",
    "e2e:db:reset": "node scripts/e2e-db-reset.mjs",
    "e2e:db:down": "docker compose stop e2e-db",
    "e2e:server": "TZ=Asia/Tokyo next dev --hostname 127.0.0.1",
    "e2e:auth": "playwright test --project=setup",
    "test:e2e": "npm run e2e:db:up && npm run e2e:db:reset && playwright test",
    "test:e2e:headed": "npm run e2e:db:up && npm run e2e:db:reset && npm run e2e:auth && E2E_DEMO_DELAY=2000 E2E_SLOW_MO=2000 playwright test tests/e2e/loan-home.spec.ts --grep=ユーザーAが借りた本はAのホームだけに表示される --headed --project=chromium --no-deps --workers=1",
    "test:e2e:ui": "npm run e2e:db:up && npm run e2e:db:reset && npm run e2e:auth && E2E_DEMO_DELAY=2000 E2E_SLOW_MO=2000 playwright test --ui --project=chromium --no-deps --workers=1",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/groq": "^3.0.39",
    "@ai-sdk/react": "^3.0.184",
    "@smastrom/react-rating": "^1.5.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@supabase/supabase-js": "^2.91.1",
    "@tiptap/extension-document": "^3.27.0",
    "@tiptap/extension-link": "^3.27.0",
    "@tiptap/extension-paragraph": "^3.27.0",
    "@tiptap/extension-text": "^3.27.0",
    "@tiptap/react": "^3.27.0",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "ai": "^6.0.182",
    "axios": "^1.13.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "googleapis": "^170.1.0",
    "groq-sdk": "^1.1.2",
    "lucide-react": "^1.14.0",
    "nanoid": "^5.1.11",
    "next": "^16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.13.3",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-avatar-editor": "^15.1.0",
    "react-dom": "19.2.3",
    "recharts": "^3.8.0",
    "shadcn": "^4.7.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20",
    "@types/pg": "^8.10.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
